# =============================================================================
# backend/.env.example — plantilla. NUNCA contiene valores reales.
# =============================================================================
# Copiar a backend/.env.local y rellenar. Ese archivo esta ignorado por Git.
#
# NUNCA colocar aqui: contrasenas, connection strings reales, service_role,
# secret keys ni tokens.
# =============================================================================

# URL del proyecto Supabase. Publica (aparece en la URL del proyecto).
SUPABASE_URL=

# Clave PUBLICABLE (sb_publishable_...). Publica por diseno; la usan los tests
# para crear usuarios de prueba contra Supabase Auth.
# NUNCA la secret key (sb_secret_...) ni service_role.
SUPABASE_PUBLISHABLE_KEY=

# Cadena de conexion del ROL BACKEND `app_backend`.
#
# Formato esperado (Session Pooler de Supabase / Supavisor):
#
#   postgresql://app_backend.<project-ref>:<password>@<pooler-host>:5432/postgres?sslmode=require
#
#   - el usuario del pooler es `<rol>.<project-ref>`, no solo `<rol>`
#   - <pooler-host> y <project-ref> se copian del Dashboard; NO se versionan
#   - la contrasena se establece fuera de banda (ver backend/README.md)
#
# TLS es obligatorio. Si se omite `sslmode`, el backend inyecta `require`; si se
# indica `disable`, `allow` o `prefer`, el backend SE NIEGA A ARRANCAR: esos modos
# permiten caer a texto plano.
#
# NUNCA usar aqui el rol `postgres`, `service_role` ni `supabase_admin`: tienen
# BYPASSRLS y anularian el aislamiento. El backend tambien los rechaza.
DATABASE_URL=

# Opcional. Por defecto se deriva de SUPABASE_URL:
#   <SUPABASE_URL>/auth/v1/.well-known/jwks.json
# SUPABASE_JWKS_URL=

# Opcional. Por defecto se deriva de SUPABASE_URL: <SUPABASE_URL>/auth/v1
# SUPABASE_JWT_ISSUER=
