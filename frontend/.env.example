# =============================================================================
# frontend/.env.example — plantilla. NUNCA contiene valores reales.
# =============================================================================
# Copiar a frontend/.env.local y rellenar desde:
#   Supabase Dashboard -> Project Settings -> API Keys
#
# Usar EXCLUSIVAMENTE la clave publicable (sb_publishable_...).
# NUNCA la secret key ni service_role: el prefijo NEXT_PUBLIC_ hace que el
# valor se incruste en el bundle del navegador y sea publico por definicion.
#
# frontend/.env.local esta ignorado por Git.
# =============================================================================

NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
