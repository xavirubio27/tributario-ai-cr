# =============================================================================
# tests/.env.example — plantilla. NUNCA contiene valores reales.
# =============================================================================
# Copiar a tests/.env.local y rellenar desde:
#   Supabase Dashboard -> Project Settings -> API Keys
#
# Usar EXCLUSIVAMENTE la clave publicable (sb_publishable_...).
# NUNCA la secret key ni service_role: los tests deben demostrar que RLS
# funciona, no esquivarla.
#
# tests/.env.local esta ignorado por Git.
# =============================================================================

SUPABASE_URL=
SUPABASE_PUBLISHABLE_KEY=
